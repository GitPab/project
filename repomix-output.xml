<file path="src/app/components/StatCard.tsx">
import React from 'react';

interface StatCardProps {
  label: string;
  value: number;
  sub?: string;
  icon: string;
  color: 'blue' | 'green' | 'teal' | 'amber' | 'gray';
}

const colorStyles = {
  blue: { border: '#185FA5', bg: '#E6F1FB' },
  green: { border: '#639922', bg: '#EAF3DE' },
  teal: { border: '#1D9E75', bg: '#E1F5EE' },
  amber: { border: '#EF9F27', bg: '#FAEEDA' },
  gray: { border: '#888780', bg: '#F1EFE8' }
};

export default function StatCard({ label, value, sub, icon, color }: StatCardProps) {
  const c = colorStyles[color] ?? colorStyles.gray;

  return (
    <div style={{
      background: 'var(--color-background-primary)',
      border: '0.5px solid var(--color-border-tertiary)',
      borderLeft: `3px solid ${c.border}`,
      borderRadius: 12,
      padding: '14px 16px'
    }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8 }}>
        <span style={{ fontSize: 12, color: 'var(--color-text-secondary)' }}>{label}</span>
        <span style={{ fontSize: 16, width: 28, height: 28, display: 'flex', alignItems: 'center', justifyContent: 'center', background: c.bg, borderRadius: 7 }}>{icon}</span>
      </div>
      <div style={{ fontSize: 26, fontWeight: 500 }}>{value?.toLocaleString()}</div>
      {sub && (
        <div style={{ fontSize: 11, color: 'var(--color-text-secondary)', marginTop: 4 }}>{sub}</div>
      )}
    </div>
  );
}
</file>

<file path="src/app/components/TierBreakdownBar.tsx">
import React from 'react';

interface TierBreakdownBarProps {
  top1: number;
  top2: number;
  top3: number;
}

export default function TierBreakdownBar({ top1, top2, top3 }: TierBreakdownBarProps) {
  const total = (top1 ?? 0) + (top2 ?? 0) + (top3 ?? 0);

  if (!total) return null;

  return (
    <div style={{ display: 'flex', height: 8, borderRadius: 4, overflow: 'hidden', gap: 2 }}>
      <div style={{ flex: top1, background: '#185FA5', borderRadius: '4px 0 0 4px' }} />
      <div style={{ flex: top2, background: '#639922' }} />
      <div style={{ flex: top3, background: '#E24B4A', borderRadius: '0 4px 4px 0' }} />
    </div>
  );
}
</file>

<file path="src/app/components/TierMini.tsx">
import React from 'react';

interface TierMiniProps {
  label: string;
  count: number;
  color: 'blue' | 'green' | 'red';
  desc: string;
}

const colorStyles = {
  blue: { bg: '#E6F1FB', text: '#0C447C', border: '#0C447C' },
  green: { bg: '#EAF3DE', text: '#3B6D11', border: '#3B6D11' },
  red: { bg: '#FCEBEB', text: '#A32D2D', border: '#A32D2D' }
};

export default function TierMini({ label, count, color, desc }: TierMiniProps) {
  const style = colorStyles[color];
  
  return (
    <div style={{
      background: style.bg,
      border: `1px solid ${style.border}`,
      borderRadius: 6,
      padding: 8,
      textAlign: 'center'
    }}>
      <div style={{ fontSize: 12, fontWeight: 600, color: style.text, marginBottom: 2 }}>
        {label}
      </div>
      <div style={{ fontSize: 16, fontWeight: 700, color: style.text, marginBottom: 2 }}>
        {count}
      </div>
      <div style={{ fontSize: 10, color: '#6B7280' }}>
        {desc}
      </div>
    </div>
  );
}
