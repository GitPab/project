        minWidth: '80px'
      }}
    >
      <span style={{ fontSize: '14px', marginRight: '4px' }}>{icon}</span>
      <span style={{ fontSize: '12px', fontWeight: 500 }}>{label}</span>
      {count !== undefined && (
        <span style={{
          backgroundColor: active ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.1)',
