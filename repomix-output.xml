  const [costCalculations, setCostCalculations] = useState<Map<string, EstimatedTotalCost>>(new Map());

  const PERK_FILTERS = [
    { key: 'all',   label: 'Tất cả' },
    { key: 'hb100', label: '🎓 HB 100%',   match: (u: University) => getMaxScholarship(u) === 100 },
    { key: 'hb50',  label: '🎓 HB 50%+',   match: (u: University) => getMaxScholarship(u) >= 50 },
    { key: 'gpa65', label: '📋 GPA ≤ 6.5', match: (u: University) => getMinGPA(u) <= 6.5 },
    { key: 'ktx',   label: '🏠 Có KTX rẻ', match: (u: University) => getCheapestKTX(u) !== null },
    { key: 'vl',    label: '💼 Việc làm',   match: (u: University) => !!u.koreanData?.jobOpportunities },
    { key: 'seoul', label: '📍 Seoul',       match: (u: University) => u.koreanData?.address?.toLowerCase().includes('seoul') || false }
  ];

  const filteredUniversities = useMemo(() => {
    const safeUniversities = (universities ?? []).filter(u => u && u.id && u.name && u.koreanData);

    return safeUniversities.filter(university => {
      if (!university.koreanData?.isKoreanUniversity) return false;

      if (activeTier !== 'all') {
        const tierMatch =
          (activeTier === '1' && university.koreanData?.topTier === 'Top1') ||
          (activeTier === '2' && university.koreanData?.topTier === 'Top2') ||
          (activeTier === '3' && university.koreanData?.topTier === 'Top3');
        if (!tierMatch) return false;
      }

      if (activePerk !== 'all') {
        const perkDef = PERK_FILTERS.find(p => p.key === activePerk);
        if (perkDef?.match && !perkDef.match(university)) return false;
      }

      if (searchTerm) {
        const q = searchTerm.toLowerCase();
        const searchable = [university.name, university.koreanName, university.koreanData?.address]
          .join(' ').toLowerCase();
        if (!searchable.includes(q)) return false;
      }

      return true;
    });
  }, [universities, activeTier, activePerk, searchTerm]);

  const tierCounts = useMemo(() => {
    const koreanUnis = universities.filter(u => u.koreanData?.isKoreanUniversity);
    const counts = { all: koreanUnis.length, '1': 0, '2': 0, '3': 0 };
    koreanUnis.forEach(uni => {
      if (uni.koreanData?.topTier === 'Top1') counts['1']++;
      else if (uni.koreanData?.topTier === 'Top2') counts['2']++;
      else if (uni.koreanData?.topTier === 'Top3') counts['3']++;
    });
    return counts;
  }, [universities]);

  useEffect(() => {
    const calculations = new Map<string, EstimatedTotalCost>();
    filteredUniversities.forEach(university => {
      try {
        const cost = calculateUniversityEstimatedCost(university);
        calculations.set(university.id, cost);
      } catch (err) {
        console.error(`Error calculating cost for ${university.name}:`, err);
        calculations.set(university.id, {
          amount: 0, currency: 'VND', systemsIncluded: [],
          breakdown: { fixedCosts: 0, optionalCosts: 0, totalCosts: 0, currency: 'VND', breakdown: [] }
        });
      }
    });
    setCostCalculations(calculations);
    setLoading(false);
  }, [filteredUniversities]);

  const handleSort = (key: 'name' | 'cost' | 'ranking') => {
    if (sortBy === key) setSortOrder(sortOrder === 'asc' ? 'desc' : 'asc');
    else { setSortBy(key); setSortOrder('asc'); }
  };

  const openEditModal = (university: University) => setEditingUniversity(university);

  const sortedUniversities = useMemo(() => {
    return [...filteredUniversities].sort((a, b) => {
      let aValue: string | number = '';
      let bValue: string | number = '';
      switch (sortBy) {
        case 'name':    aValue = a.name; bValue = b.name; break;
        case 'cost':    aValue = costCalculations.get(a.id)?.amount || 0; bValue = costCalculations.get(b.id)?.amount || 0; break;
        case 'ranking': aValue = a.koreanData?.koreanRanking ? parseInt(a.koreanData.koreanRanking) : Infinity; bValue = b.koreanData?.koreanRanking ? parseInt(b.koreanData.koreanRanking) : Infinity; break;
      }
      if (aValue < bValue) return sortOrder === 'asc' ? -1 : 1;
      if (aValue > bValue) return sortOrder === 'asc' ? 1 : -1;
      return 0;
    });
  }, [filteredUniversities, sortBy, sortOrder, costCalculations]);

  return (
    <div style={{ padding: '24px' }}>

      {/* Header */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 }}>
        <div>
          <h1 style={{ fontSize: 22, fontWeight: 500, color: 'var(--color-text-primary)' }}>Danh sách trường</h1>
          <p style={{ fontSize: 13, color: 'var(--color-text-secondary)', marginTop: 4 }}>
            {filteredUniversities.length} trường · Lọc theo ưu đãi
          </p>
        </div>
        <div style={{ display: 'flex', gap: 8 }}>
          <button
            onClick={() => window.location.reload()}
            style={{ padding: '8px', borderRadius: 8, border: '0.5px solid var(--color-border-tertiary)', background: 'none', cursor: 'pointer' }}
          >
            <RefreshCw size={16} />
          </button>
          <button
            onClick={() => setShowAddModal(true)}
            style={{ display: 'flex', alignItems: 'center', gap: 6, padding: '8px 16px', borderRadius: 8, border: 'none', background: '#185FA5', color: '#fff', cursor: 'pointer', fontSize: 13, fontWeight: 500 }}
          >
            <Plus size={16} />
            Thêm trường
          </button>
        </div>
      </div>

      {/* Search bar */}
      <div style={{ marginBottom: 12 }}>
        <div style={{ position: 'relative' }}>
          <Search size={16} style={{ position: 'absolute', left: 12, top: '50%', transform: 'translateY(-50%)', color: 'var(--color-text-secondary)' }} />
          <input
            type="text"
            placeholder="Tìm tên trường..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            style={{ width: '100%', paddingLeft: 38, paddingRight: 16, paddingTop: 9, paddingBottom: 9, borderRadius: 8, border: '0.5px solid var(--color-border-tertiary)', fontSize: 13, background: 'var(--color-background-primary)', color: 'var(--color-text-primary)', outline: 'none', boxSizing: 'border-box' }}
          />
        </div>
      </div>

      {/* Tier tabs */}
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr 1fr', gap: 8, marginBottom: 12 }}>
        <TierTab active={activeTier === 'all'} onClick={() => setActiveTier('all')} icon="☰" label="Tất cả" count={tierCounts.all} colorClass="gray" />
        <TierTab active={activeTier === '1'} onClick={() => setActiveTier('1')} icon={TOP_TIERS['1'].icon} label={TOP_TIERS['1'].label} count={tierCounts['1']} description="Dễ visa nhất" colorClass="blue" />
        <TierTab active={activeTier === '2'} onClick={() => setActiveTier('2')} icon={TOP_TIERS['2'].icon} label={TOP_TIERS['2'].label} count={tierCounts['2']} description="Visa trung bình" colorClass="green" />
        <TierTab active={activeTier === '3'} onClick={() => setActiveTier('3')} icon={TOP_TIERS['3'].icon} label={TOP_TIERS['3'].label} count={tierCounts['3']} description="Hạn chế visa" colorClass="red" />
      </div>

      {/* Top 3 warning */}
      {activeTier === '3' && TOP_TIERS['3'].warning && (
        <div style={{ background: getTierBg('3'), border: `0.5px solid ${getTierColor('3')}`, borderRadius: 8, padding: '8px 12px', fontSize: 12, color: getTierColor('3'), marginBottom: 8 }}>
          ⚠ {TOP_TIERS['3'].warning}
        </div>
      )}

      {/* Perk filter */}
      <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 12 }}>
        {PERK_FILTERS.map(perk => (
          <button
            key={perk.key}
            onClick={() => setActivePerk(perk.key)}
            style={{
              padding: '6px 12px', borderRadius: 20, fontSize: 12, cursor: 'pointer', whiteSpace: 'nowrap',
              border: activePerk === perk.key ? '0.5px solid #185FA5' : '0.5px solid var(--color-border-tertiary)',
              background: activePerk === perk.key ? '#E6F1FB' : 'var(--color-background-primary)',
              color: activePerk === perk.key ? '#185FA5' : 'var(--color-text-secondary)',
              fontWeight: activePerk === perk.key ? 500 : 400,
            }}
          >
            {perk.label}
          </button>
        ))}
      </div>

      {/* Count */}
      <div style={{ fontSize: 13, color: 'var(--color-text-secondary)', marginBottom: 12, fontWeight: 500 }}>
        {filteredUniversities.length} trường · {activeTier === 'all' ? '3 cấp độ visa' : `Top ${activeTier}`}
        {activePerk !== 'all' && ` · ${PERK_FILTERS.find(p => p.key === activePerk)?.label}`}
      </div>

      {/* Column headers */}
      {!loading && !error && filteredUniversities.length > 0 && (
        <div style={{ display: 'grid', gridTemplateColumns: '2fr 120px 1.8fr 1.4fr 100px', gap: 16, padding: '6px 16px', fontSize: 11, fontWeight: 500, color: 'var(--color-text-secondary)', textTransform: 'uppercase', letterSpacing: '0.3px', marginBottom: 4 }}>
          <span>Trường</span>
          <span style={{ textAlign: 'right' }}>Học phí thấp nhất</span>
          <span>Ưu đãi nổi bật</span>
          <span>Học bổng tốt nhất</span>
          <span style={{ textAlign: 'right' }}>Thao tác</span>
        </div>
      )}

      {/* Content */}
      {loading ? (
        <div style={{ textAlign: 'center', padding: 40, color: 'var(--color-text-secondary)', fontSize: 14 }}>Đang tải...</div>
      ) : error ? (
        <div style={{ textAlign: 'center', padding: 40, color: '#E24B4A', fontSize: 14 }}>{error}</div>
      ) : filteredUniversities.length === 0 ? (
        <div style={{ textAlign: 'center', padding: 40, color: 'var(--color-text-secondary)', fontSize: 14 }}>Không tìm thấy trường nào</div>
      ) : (
        <>
          <div>
            {sortedUniversities.map((university) => (
              <UniversityCard key={university.id} university={university} onEdit={openEditModal} />
            ))}
          </div>

          {/* Legend */}
          <div style={{ marginTop: 12, padding: '8px 12px', background: 'var(--color-background-secondary)', borderRadius: 8, fontSize: 11, color: 'var(--color-text-secondary)', display: 'flex', gap: 16, flexWrap: 'wrap' }}>
            <span>🎓 HB = Học bổng giảm học phí theo TOPIK</span>
            <span>🏠 KTX = Ký túc xá trong trường</span>
            <span>💼 = Khu vực có việc làm thêm</span>
            <span>📋 GPA = Điều kiện xét tuyển</span>
          </div>
        </>
      )}

      {/* Add Modal */}
      {showAddModal && (
        <UniversityForm
          onClose={() => setShowAddModal(false)}
          onSave={() => { toast.success('Thêm trường thành công!'); setShowAddModal(false); }}
        />
      )}

      {/* Edit Modal */}
      {editingUniversity && (
        <EditUniversityModal
          university={editingUniversity}
          onClose={() => setEditingUniversity(null)}
          onSave={async () => { toast.success('Cập nhật trường thành công!'); setEditingUniversity(null); }}
        />
      )}
    </div>
  );
}
</file>

<file path="src/app/components/UniversityCard.tsx">
import React from 'react';
import { useNavigate } from 'react-router';
import { useApp } from '../context/AppContext';
import { getLowestFee, getPerks, getMaxScholarship, getBestScholarshipSystem, getBestTopikLevel, getScholarshipTierString } from '../../utils/universityPerks';
import type { University } from '../context/AppContext';

interface UniversityCardProps {
  university: University;
  onEdit: (university: University) => void;
}

const ALL_VISA = ['D4-1', 'D2-1', 'D2-2', 'D2-3', 'D2-6'];

export default function UniversityCard({ university, onEdit }: UniversityCardProps) {
  const navigate = useNavigate();
  const { user } = useApp();

  const lowestFee = getLowestFee(university);
  const perks = getPerks(university);
  const maxHB = getMaxScholarship(university);
  const bestHBSystem = getBestScholarshipSystem(university);
  const scholarshipTierString = getScholarshipTierString(university);

  const getPerkStyles = (perkType: string) => {
    const styles: { [key: string]: { background: string; color: string; borderColor: string } } = {
      hb: { background: '#EAF3DE', color: '#3B6D11', borderColor: '#C0DD97' },
      ktx: { background: '#E6F1FB', color: '#0C447C', borderColor: '#B5D4F4' },
      vl: { background: '#FAEEDA', color: '#854F0B', borderColor: '#FAC775' },
      gpa: { background: '#EEEDFE', color: '#3C3489', borderColor: '#CECBF6' },
      warn: { background: '#FCEBEB', color: '#A32D2D', borderColor: '#F7C1C1' },
      default: { background: '#E1F5EE', color: '#0F6E56', borderColor: '#9FE1CB' }
    };
    return styles[perkType] || styles.default;
  };

  const minGPA = university?.koreanData?.admission?.['D4-1']?.gpaMin ?? null;
  const gpaFormatted = minGPA ? `≥ ${minGPA}` : '?';
  const isEasyGPA = minGPA && minGPA <= 6.5;

  return (
    <div
      style={{
        background: 'var(--color-background-primary)',
        border: '0.5px solid var(--color-border-tertiary)',
        borderRadius: 12,
        padding: '14px 16px',
        marginBottom: 8,
        display: 'grid',
        gridTemplateColumns: '2fr 120px 1.8fr 1.4fr 100px',
        gap: 16,
        alignItems: 'center',
        transition: 'border-color 0.15s',
        cursor: 'default'
      }}
      onMouseEnter={(e) => (e.currentTarget as HTMLElement).style.borderColor = '#185FA5'}
      onMouseLeave={(e) => (e.currentTarget as HTMLElement).style.borderColor = 'var(--color-border-tertiary)'}
    >
      {/* COL 1 — University info */}
      <div>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 2 }}>
          <span style={{ fontWeight: 500, fontSize: 14 }}>{university.name}</span>
          <span style={{ fontSize: 11, color: 'var(--color-text-secondary)' }}>
            {university.koreanName || university.koreanData?.name}
          </span>
        </div>
        <div style={{ fontSize: 11, color: 'var(--color-text-secondary)', marginBottom: 6 }}>
          {university.koreanData?.address} · Top {university.koreanData?.topTier?.replace('Top', '')}
        </div>
        {/* Visa dots */}
        <div style={{ display: 'flex', gap: 4, flexWrap: 'wrap' }}>
          {ALL_VISA.map((key) => {
            const on = university?.koreanData?.visaSystemsDetail?.[key]?.available === true;
            return (
              <span
                key={key}
                style={{
                  padding: '1px 6px',
                  borderRadius: 5,
                  fontSize: 10,
                  fontWeight: 500,
                  background: on ? '#185FA5' : 'var(--color-background-secondary)',
                  color: on ? '#fff' : 'var(--color-text-secondary)',
                  opacity: on ? 1 : 0.45
                }}
              >
                {key}
              </span>
            );
          })}
        </div>
      </div>

      {/* COL 2 — Lowest fee */}
      <div style={{ textAlign: 'right' }}>
        {lowestFee ? (
          <>
            <div style={{ fontSize: 14, fontWeight: 500, color: '#185FA5' }}>
              {(lowestFee.fee / 1000000).toFixed(1)}M ₩
            </div>
            <div style={{ fontSize: 10, color: 'var(--color-text-secondary)', marginTop: 2 }}>
              {lowestFee.key} · mỗi năm
            </div>
            <div
              style={{
                fontSize: 10,
                marginTop: 2,
                color: isEasyGPA ? '#3B6D11' : 'var(--color-text-secondary)',
                fontWeight: isEasyGPA ? 500 : 400
              }}
            >
              GPA {gpaFormatted}
              {isEasyGPA ? ' ✓' : ''}
            </div>
          </>
        ) : (
          <div style={{ fontSize: 12, color: '#A32D2D' }}>— Hạn chế visa</div>
        )}
      </div>

      {/* COL 3 — Perks */}
      <div style={{ display: 'flex', flexWrap: 'wrap', gap: 4 }}>
        {perks.map((perk, i) => {
          const styles = getPerkStyles(perk.type);
          return (
            <span
              key={i}
              style={{
                display: 'inline-flex',
                alignItems: 'center',
                gap: 3,
                padding: '3px 8px',
                borderRadius: 8,
                fontSize: 11,
                fontWeight: 500,
                border: '0.5px solid',
                background: styles.background,
                color: styles.color,
                borderColor: styles.borderColor
              }}
            >
              {perk.label}
            </span>
          );
        })}
      </div>

      {/* COL 4 — Best scholarship */}
      <div>
        {maxHB > 0 ? (
          <>
            <div style={{ fontSize: 11, color: 'var(--color-text-secondary)', marginBottom: 4 }}>
              {bestHBSystem} · TOPIK {getBestTopikLevel(university)}
            </div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
              <div
                style={{
                  flex: 1,
                  height: 5,
                  background: 'var(--color-background-secondary)',
                  borderRadius: 3,
                  overflow: 'hidden'
                }}
              >
                <div
                  style={{
                    width: `${maxHB}%`,
                    height: '100%',
                    borderRadius: 3,
                    background: maxHB === 100 ? '#639922' : maxHB >= 50 ? '#EF9F27' : '#D3D1C7'
                  }}
                />
              </div>
              <span
                style={{
                  fontSize: 12,
                  fontWeight: 500,
                  minWidth: 35,
                  textAlign: 'right',
                  color: maxHB === 100 ? '#3B6D11' : '#854F0B'
                }}
              >
                -{maxHB}%
              </span>
            </div>
            <div style={{ fontSize: 10, color: 'var(--color-text-secondary)', marginTop: 3 }}>
              {scholarshipTierString}
            </div>
          </>
        ) : (
          <span style={{ color: 'var(--color-text-secondary)', fontSize: 13 }}>—</span>
        )}
      </div>

      {/* COL 5 — Actions */}
      <div style={{ display: 'flex', gap: 6, justifyContent: 'flex-end' }}>
        <button
          onClick={() => navigate(`/${user?.role}/university/${university.id}`)}
          style={{
            padding: '6px 12px',
            borderRadius: 8,
            border: '0.5px solid var(--color-border-tertiary)',
            background: 'none',
            cursor: 'pointer',
            fontSize: 12
          }}
        >
          Xem
        </button>
        <button
          onClick={() => onEdit(university)}
          style={{
            padding: '6px 12px',
            borderRadius: 8,
            border: 'none',
            background: '#185FA5',
            color: '#fff',
            cursor: 'pointer',
            fontSize: 12
          }}
        >
          Sửa
        </button>
      </div>
    </div>
  );
}
</file>

