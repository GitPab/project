  const ALL_VISA_OPTIONS = [
    { type: 'D4-1' as const, label: 'D4-1', name: '(Tiß║┐ng H├án)', description: 'Korean Language Program' },
    { type: 'D2-1' as const, label: 'D2-1', name: '(Chuß║⌐n bß╗ï)', description: 'University Preparation' },
    { type: 'D2-2' as const, label: 'D2-2', name: '(─Éß║íi hß╗ìc)', description: 'Undergraduate' },
    { type: 'D2-3' as const, label: 'D2-3', name: '(Sau ─æß║íi hß╗ìc)', description: 'Graduate' },
    { type: 'D2-6' as const, label: 'D2-6', name: '(N├óng cao)', description: 'Advanced' },
