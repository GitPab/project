@startuml DuHocCost_AuthSequence

title Authentication Flow - Sequence Diagram

actor User
participant "Frontend" as Frontend
participant "Backend API" as Backend
participant "Database" as DB
participant "JWT Service" as JWT

User -> Frontend: Enter credentials
Frontend -> Backend: POST /api/login
Backend -> DB: SELECT user by email
DB --> Backend: user data
Backend -> Backend: Verify password
Backend -> JWT: Generate token
JWT --> Backend: token
Backend --> Frontend: {token, user}
Frontend -> Frontend: Store token (localStorage)
Frontend -> Frontend: Decode role from token
Frontend -> Frontend: Render UI based on role

User -> Frontend: Access protected route
Frontend -> Backend: Request with Authorization header
Backend -> JWT: Verify token
JWT --> Backend: decoded payload
Backend -> Backend: Check permissions
Backend -> DB: Execute query
DB --> Backend: Results
Backend --> Frontend: Response data
Frontend --> User: Display data

@enduml

@startuml DuHocCost_AdminInviteSequence

title Admin Invite Flow - Sequence Diagram

actor Admin
participant "Frontend" as Frontend
participant "Backend API" as Backend
participant "Database" as DB
participant "Email Service" as Email

Admin -> Frontend: Fill invite form (email, name, role)
Frontend -> Backend: POST /api/admin/invite
Backend -> Backend: Check Admin permissions
Backend -> Backend: Generate setup_token
Backend -> DB: INSERT INTO invitations
DB --> Backend: Success
Backend -> DB: INSERT INTO users (pending)
DB --> Backend: Success
Backend --> Frontend: {success, setupUrl}
Frontend --> Admin: Display invite link

Admin -> Email: Share setup link (manual)
Email -> Frontend: New user clicks link
Frontend -> Backend: GET /api/admin/verify-setup?token=xxx
Backend -> DB: Verify token
DB --> Backend: Valid
Backend --> Frontend: {valid, email}

Frontend -> Backend: POST /api/admin/setup-password
Backend -> Backend: Hash password
Backend -> DB: UPDATE users SET password, clear token
DB --> Backend: Success
Backend --> Frontend: {success}
Frontend --> Email: Redirect to login

@enduml

@startuml DuHocCost_ClassDiagram

title Component Class Diagram

class AuthProvider {
    +User user
    +boolean isAdmin
    +boolean isLoading
    +login(email, password)
    +logout()
    +hasPermission(permission)
}

class AppProvider {
    +Array universities
    +Array students
    +Array registrations
    +addUniversity(data)
    +updateUniversity(id, data)
    +deleteUniversity(id)
    +addUniversities(data)
}

class Layout {
    +boolean sidebarCollapsed
    +Array menuItems
    +toggleSidebar()
    +handleLogout()
}

class PermissionGuard {
    +string permission
    +ReactNode children
    +ReactNode fallback
    -checkPermission()
    +render()
}

class PermissionRoute {
    +string permission
    +ReactNode children
    +ReactNode fallback
    +render()
}

class AdminInvite {
    -Array invitedUsers
    -boolean showInviteForm
    -string copiedLink
    +inviteUser(data)
    +resendInvite(id)
    +fetchInvitedUsers()
}

class UniversitiesList {
    -Array universities
    -string searchQuery
    -boolean showAddModal
    +handleSearch(query)
    +handleAdd(university)
    +handleEdit(id, data)
    +handleDelete(id)
    +handleQuickInfo(id)
}

class UniversityForm {
    -object formData
    -boolean loading
    +handleSubmit(data)
    +handleImageUpload(file)
}

class AdminDashboard {
    -object stats
    -Array recentActivity
    +fetchDashboardData()
    +handleImportCSV()
}

AuthProvider "1" --> "1" Layout : provides auth state
AppProvider "1" --> "1" UniversitiesList : provides data
AuthProvider "1" --> "1" PermissionGuard : provides permission check
Layout "1" --> "1" AdminInvite : contains
Layout "1" --> "1" UniversitiesList : contains
Layout "1" --> "1" AdminDashboard : contains
UniversitiesList "1" --> "1" UniversityForm : uses
PermissionRoute ..> PermissionGuard : uses

@enduml

