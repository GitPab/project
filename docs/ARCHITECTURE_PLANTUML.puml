title Du Học Cost - Updated System Architecture with Improvements

package "Client Layer" {
    [Web Browser] as Client
}

package "Frontend (Vercel)" {
    [React + Vite App] as Frontend
    [React Router] as Router
    [Zustand Store] as Zustand
    [React Query] as ReactQuery
    [Error Boundaries] as ErrorBoundaries
    [RBAC Components] as RBAC
    [UI Components] as UI
}

package "Backend (Render)" {
    [Node.js + Express] as Backend
    [Rate Limiting] as RateLimit
    [Authentication Middleware] as AuthMiddleware
    [RBAC Middleware] as RBACMiddleware
    [API Routes] as Routes
    [File Upload Handler] as Upload
    
    package "New Improvements" {
        [Redis Cache] as Redis
        [Winston Logger] as Logger
        [Connection Pool Monitor] as PoolMonitor
        [CSV Sanitizer] as CSVSanitizer
        [Email Service] as EmailService
        [Swagger Docs] as Swagger
    }
}

package "Database Layer" {
    database "PostgreSQL" as DB {
        [Users Table] as UsersTbl
        [Universities Table] as UnivTbl
        [Registrations Table] as RegTbl
        [Student Progress Table] as ProgTbl
        [Audit Logs Table] as AuditTbl
    }
}

package "External Services" {
    [Supabase Storage] as Supabase
    [Imgur API] as Imgur
    [SendGrid/SMTP] as EmailProvider
    [JWT Token Service] as JWT
}

Client --> Frontend : HTTPS
Frontend --> Backend : REST API
Frontend --> Zustand : State Management
Frontend --> ReactQuery : Data Fetching
Frontend --> ErrorBoundaries : Error Handling

Backend --> DB : SQL Queries
Backend --> Redis : Cache Operations
Backend --> Logger : Structured Logging
Backend --> PoolMonitor : Connection Metrics
Backend --> CSVSanitizer : Input Validation
Backend --> EmailService : Email Sending
Backend --> Swagger : API Documentation

Backend --> Supabase : Image Storage (Primary)
Backend --> Imgur : Image Storage (Fallback)
Backend --> EmailProvider : Email Delivery
Backend --> JWT : Token Verify

Redis --> DB : Cache Invalidation
PoolMonitor --> DB : Monitor Connections

DB --> UsersTbl
DB --> UnivTbl
DB --> RegTbl
DB --> ProgTbl
DB --> AuditTbl

