@startuml DuHocCost_DatabaseER_Updated

title Database Schema - Updated ER Diagram

entity "USERS" as Users {
    * id : UUID <<PK>>
    --
    * email : String <<UK>>
    * name : String
    * password_hash : String
    * role : Enum
    phone : String
    last_login : Timestamp
    is_active : Boolean <<Default: true>>
    setup_token : String
    setup_token_expiry : Timestamp
    invited_by : UUID <<FK>>
    created_at : Timestamp
    updated_at : Timestamp
}

entity "UNIVERSITIES" as Universities {
    * id : UUID <<PK>>
    --
    * name : String
    korean_name : String
    country : String <<Default: 'Hàn Quốc'>>
    region : String
    ranking : Integer
    top_tier : String
    hero_image : String
    thumbnail : String
    korean_data : JSONB
    cache_version : Integer
    updated_by : UUID <<FK>>
    is_active : Boolean <<Default: true>>
    created_at : Timestamp
    updated_at : Timestamp
}

entity "REGISTRATIONS" as Registrations {
    * id : UUID <<PK>>
    --
    * student_id : UUID <<FK>>
    * university_id : UUID <<FK>>
    * status : Enum
    visa_system : String
    form_data : JSONB
    created_at : Timestamp
    updated_at : Timestamp
}

entity "STUDENT_PROGRESS" as Progress {
    * id : UUID <<PK>>
    --
    * student_id : UUID <<FK>>
    * registration_id : UUID <<FK>>
    * stage : Enum
    progress_data : JSONB
    created_at : Timestamp
    updated_at : Timestamp
}

entity "AUDIT_LOGS" as AuditLogs {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    * action : Enum <<CREATE|UPDATE|DELETE|RESTORE|LOGIN|LOGOUT>>
    * entity_type : String
    entity_id : UUID
    old_values : JSONB
    new_values : JSONB
    ip_address : INET
    user_agent : Text
    created_at : Timestamp
}

entity "INVITATIONS" as Invitations {
    * id : UUID <<PK>>
    --
    * email : String <<UK>>
    * name : String
    * role : String
    invited_by : UUID <<FK>>
    setup_token : String
    setup_token_expiry : Timestamp
    email_sent : Boolean <<Default: false>>
    email_sent_at : Timestamp
    created_at : Timestamp
    used : Boolean <<Default: false>>
}

Users ||--o{ Registrations : "makes"
Users ||--o{ Progress : "has"
Users ||--o{ Invitations : "invited_by"
Users ||--o{ AuditLogs : "performs"
Universities ||--o{ Registrations : "receives"
Universities ||--o{ AuditLogs : "tracked_in"
Registrations ||--o{ Progress : "tracks"

@enduml

