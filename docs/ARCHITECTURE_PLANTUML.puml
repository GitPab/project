@startuml DuHocCost_AuthSequence

title Authentication Flow - Sequence Diagram

actor User
participant "Frontend" as Frontend
participant "Backend API" as Backend
participant "Database" as DB
participant "JWT Service" as JWT

User -> Frontend: Enter credentials
Frontend -> Backend: POST /api/login
Backend -> DB: SELECT user by email
DB --> Backend: user data
Backend -> Backend: Verify password
Backend -> JWT: Generate token
JWT --> Backend: token
Backend --> Frontend: {token, user}
Frontend -> Frontend: Store token (localStorage)
Frontend -> Frontend: Decode role from token
Frontend -> Frontend: Render UI based on role

User -> Frontend: Access protected route
Frontend -> Backend: Request with Authorization header
Backend -> JWT: Verify token
JWT --> Backend: decoded payload
Backend -> Backend: Check permissions
Backend -> DB: Execute query
DB --> Backend: Results
Backend --> Frontend: Response data
Frontend --> User: Display data

@enduml

@startuml DuHocCost_AdminInviteSequence

title Admin Invite Flow - Sequence Diagram

actor Admin
participant "Frontend" as Frontend
participant "Backend API" as Backend
participant "Database" as DB
participant "Email Service" as Email

Admin -> Frontend: Fill invite form (email, name, role)
Frontend -> Backend: POST /api/admin/invite
Backend -> Backend: Check Admin permissions
Backend -> Backend: Generate setup_token
Backend -> DB: INSERT INTO invitations
DB --> Backend: Success
Backend -> DB: INSERT INTO users (pending)
DB --> Backend: Success
Backend --> Frontend: {success, setupUrl}
Frontend --> Admin: Display invite link

Admin -> Email: Share setup link (manual)
Email -> Frontend: New user clicks link
Frontend -> Backend: GET /api/admin/verify-setup?token=xxx
Backend -> DB: Verify token
DB --> Backend: Valid
Backend --> Frontend: {valid, email}

Frontend -> Backend: POST /api/admin/setup-password
Backend -> Backend: Hash password
Backend -> DB: UPDATE users SET password, clear token
DB --> Backend: Success
Backend --> Frontend: {success}
Frontend --> Email: Redirect to login

@enduml

@startuml DuHocCost_ClassDiagram

title Component Class Diagram (Updated April 2026)

class AuthProvider {
    +User user
    +boolean isAdmin
    +boolean isLoading
    +login(email, password)
    +logout()
    +hasPermission(permission)
}

class AppProvider {
    +Array universities
    +Array students
    +Array registrations
    +addUniversity(data)
    +updateUniversity(id, data)
    +deleteUniversity(id)
    +addUniversities(data)
}

class MainLayout {
    +boolean isAuthenticated
    +Array navItems
    +handleLogout()
    +renderNavigation()
}

class AdminLayout {
    +boolean sidebarCollapsed
    +Array menuItems
    +User user
    +toggleSidebar()
    +handleLogout()
}

class StudentLayout {
    +boolean sidebarCollapsed
    +Array menuItems
    +User user
    +toggleSidebar()
    +handleLogout()
}

class Login {
    +string email
    +string password
    +boolean isLoading
    +handleSubmit()
}

class Register {
    +object formData
    +boolean isLoading
    +boolean success
    +handleSubmit()
}

class AuthGuard {
    +string requiredRole
    +ReactNode children
    +boolean isAuthenticated
    +checkAuth()
}

class StudentDashboard {
    +Student student
    +Array stats
    +Array quickLinks
    +Array recentActivity
}

class StudentProfile {
    +Student profile
    +boolean isEditing
    +handleSubmit()
    +toggleEdit()
}

class StudentList {
    +Array students
    +string searchTerm
    +string statusFilter
    +handleSearch()
    +handleFilter()
}

class useStudents {
    +Array students
    +boolean isLoading
    +function fetchStudents()
    +function createStudent()
    +function updateStudent()
    +function deleteStudent()
}

class UniversityList {
    +Array universities
    +string searchTerm
    +string tierFilter
    +handleSearch()
    +handleFilter()
}

class UniversityDetail {
    +University university
    +Array relatedUniversities
}

class UniversityForm {
    +object formData
    +Array majors
    +boolean isLoading
    +handleSubmit()
    +addMajor()
    +removeMajor()
}

class useUniversities {
    +Array universities
    +boolean isLoading
    +function fetchUniversities()
    +function createUniversity()
    +function updateUniversity()
    +function deleteUniversity()
}

class Button {
    +string variant
    +string size
    +boolean isLoading
    +handleClick()
}

class Modal {
    +boolean isOpen
    +string title
    +ReactNode children
    +function onClose()
}

class Card {
    +string title
    +string subtitle
    +ReactNode children
    +ReactNode footer
}

class Table {
    +Array data
    +Array columns
    +function keyExtractor
    +boolean isLoading
}

class Form {
    +object values
    +object errors
    +function handleSubmit()
    +function handleChange()
}

class useFetch {
    +any data
    +boolean isLoading
    +Error error
    +function refetch()
}

class useForm {
    +object values
    +object errors
    +boolean isSubmitting
    +function handleSubmit()
    +function handleChange()
    +function resetForm()
}

class PermissionGuard {
    +string permission
    +ReactNode children
    +ReactNode fallback
    -checkPermission()
    +render()
}

class PermissionRoute {
    +string permission
    +ReactNode children
    +ReactNode fallback
    +render()
}

