@startuml Timing_JWTLifecycle
!theme plain
title JWT Token Lifecycle - Timing Diagram

concise "Token State" as Token
robust "User Activity" as User
robust "Auth Check" as Auth

@Token
0 is Created
60 is Active
120 is NearExpiry
140 is Refreshed
180 is Active2
240 is Expired

@User
0 is Login
30 is Browsing
90 is APIRequest1
150 is APIRequest2
250 is ExpiredRedirect

@Auth
0 is GenerateToken
120 is CheckExpiry
140 is RefreshToken
240 is TokenInvalid

@Token
0 -> @User @ 0 : Issue token
@Token
0 -> @Auth @ 0 : Store secret

@User @ 90 -> @Auth @ 90 : API call
@Auth @ 90 -> @Token @ 90 : Verify
@Token -> @Auth : Valid

@Token @ 120 -> @Auth @ 120 : Near expiry
@Auth @ 140 -> @Token @ 140 : Refresh
@Token @ 140 -> @User @ 140 : New token

@User @ 250 -> @Auth @ 250 : API call
@Auth @ 250 -> @Token @ 250 : Verify
@Token -> @Auth : Expired
@Auth -> @User : Redirect to login

@enduml

@startuml Timing_DatabaseTransaction
!theme plain
title Database Transaction - Timing Diagram

robust "Application" as App
robust "Connection Pool" as Pool
robust "Transaction" as Tx
robust "PostgreSQL" as DB

@App
0 is BeginOperation
10 is GetConnection
50 is ExecuteQueries
90 is Commit
100 is Release

@Pool
0 is Idle
10 is Checkout
100 is Checkin

@Tx
20 is BEGIN
30 is Query1
45 is Query2
60 is Query3
90 is COMMIT

@DB
30 is Execute1
45 is Execute2
60 is Execute3
90 is Persist

App -> Pool @ 10 : Acquire connection
Pool -> Tx @ 20 : BEGIN TRANSACTION
Tx -> DB @ 30 : INSERT/UPDATE 1
Tx -> DB @ 45 : INSERT/UPDATE 2
Tx -> DB @ 60 : INSERT/UPDATE 3
App -> Tx @ 90 : COMMIT
Tx -> DB @ 90 : Write to disk
App -> Pool @ 100 : Release connection

@enduml

