@startuml Sequence_Timing_Authentication
title Authentication Process - Sequence with Timing

actor User
participant "Browser" as Browser
participant "Frontend" as Frontend
participant "Backend" as Backend
database "Database" as DB

== Phase 1: User Action (0-100ms) ==
User -> Browser : Click login button
Browser -> Frontend : Enter credentials

== Phase 2: Frontend Validation (100-200ms) ==
Frontend -> Frontend : Validate form (100ms)
Frontend -> Backend : POST /api/login (200ms)

== Phase 3: Backend Processing (200-300ms) ==
Backend -> DB : SELECT user (220ms)
DB --> Backend : Return user data (240ms)
Backend -> Backend : Verify password (260ms)
Backend -> Backend : Generate JWT token (280ms)
Backend --> Frontend : {token, user} (300ms)

== Phase 4: Completion (300-350ms) ==
Frontend -> Frontend : Store token (320ms)
Frontend --> Browser : Redirect to dashboard (350ms)
Browser --> User : Display dashboard

@enduml

@startuml Sequence_Timing_APIRequest
title API Request Response - Sequence with Timing

participant "Client" as Client
participant "Server" as Server
participant "Auth" as Auth
participant "Controller" as Ctrl
database "DB" as DB

== Phase 1: Request Initiation (0-15ms) ==
Client -> Server : HTTP Request (10ms)
Server -> Auth : Route & Verify JWT (15ms)

== Phase 2: Authentication (15-40ms) ==
Auth -> Auth : Verify token (30ms)
Auth -> Ctrl : Attach user (40ms)

== Phase 3: Processing (40-75ms) ==
Ctrl -> Ctrl : Check permission (50ms)
Ctrl -> DB : SQL Query (60ms)
DB --> Ctrl : Return results (70ms)
Ctrl -> Ctrl : Format response (75ms)

== Phase 4: Response (75-80ms) ==
Ctrl --> Server : Response ready
Server --> Client : HTTP Response (80ms)

@enduml

@startuml Sequence_Timing_UniversityCRUD
title University CRUD - Sequence with Timing

actor Admin
participant "React" as React
participant "API" as API
participant "Route" as Route
participant "Controller" as Ctrl
database "PostgreSQL" as DB

== Phase 1: User Action (0-65ms) ==
Admin -> React : Click Add University (10ms)
React -> React : Open Modal (30ms)
Admin -> React : Submit form (60ms)
React -> React : Validate form (65ms)

== Phase 2: API Call (65-100ms) ==
React -> API : POST /api/universities
API -> Route : HTTP Request (70ms)
Route -> Ctrl : Route to controller (75ms)
Ctrl -> DB : INSERT INTO (80ms)
DB --> Ctrl : New ID (90ms)
Ctrl --> API : 201 Created (95ms)
API --> React : Response (100ms)

== Phase 3: UI Update (100-105ms) ==
React -> React : Update UI
React --> Admin : Success message (105ms)

@enduml

@startuml Sequence_Timing_JWTLifecycle
title JWT Token Lifecycle - Sequence with Timing

participant "User" as User
participant "Auth" as Auth
participant "Token" as Token

== Token Creation (0ms) ==
User -> Auth : Login request
Auth -> Token : Generate token
Token --> User : Issue token (0ms)

== Active Usage (0-120ms) ==
User -> User : Browsing (30ms)
User -> Auth : API call 1 (90ms)
Auth -> Token : Verify
Token --> Auth : Valid
Auth --> User : Response

== Token Refresh (120-140ms) ==
Auth -> Token : Check expiry (120ms)
Auth -> Token : Refresh token (140ms)
Token --> User : New token (140ms)

== Token Expired (250ms) ==
User -> Auth : API call 2 (250ms)
Auth -> Token : Verify
Token --> Auth : Expired!
Auth --> User : Redirect to login

@enduml

@startuml Sequence_Timing_DatabaseTransaction
title Database Transaction - Sequence with Timing

participant "Application" as App
participant "Pool" as Pool
participant "Transaction" as Tx
database "PostgreSQL" as DB

== Acquire Connection (0-10ms) ==
App -> Pool : Acquire connection (10ms)

== Execute Transaction (10-90ms) ==
Pool -> Tx : BEGIN TRANSACTION (20ms)
Tx -> DB : INSERT/UPDATE 1 (30ms)
Tx -> DB : INSERT/UPDATE 2 (45ms)
Tx -> DB : INSERT/UPDATE 3 (60ms)

== Commit (90-100ms) ==
App -> Tx : COMMIT (90ms)
Tx -> DB : Write to disk
DB --> Tx : Persist complete
Tx --> Pool : Transaction complete
Pool --> App : Release connection (100ms)

@enduml

@startuml Sequence_Timing_BulkImport
title CSV Import - Sequence with Timing

participant "Frontend" as FE
participant "Parser" as Parser
participant "Validator" as Validator
participant "Backend" as BE
database "Database" as DB

== Parse & Validate (0-80ms) ==
FE -> FE : Select & Read file (10ms)
FE -> Parser : Parse CSV (20ms)
Parser --> FE : Parsed data (60ms)
FE -> Validator : Validate rows (60ms)
Validator --> FE : Valid rows (80ms)

== Database Import (210-490ms) ==
FE -> BE : POST import (210ms)
BE -> DB : BEGIN transaction (220ms)
BE -> DB : INSERT row 1 (230ms)
BE -> DB : INSERT row 2 (240ms)
BE -> DB : INSERT row N (260ms)
BE -> DB : COMMIT (470ms)
DB --> BE : Success (480ms)
BE --> FE : Import complete (490ms)

@enduml

@startuml Sequence_Timing_FileUpload
title Image Upload - Sequence with Timing

participant "User" as User
participant "React" as React
participant "API" as API
participant "Backend" as BE
participant "Imgur" as Imgur

== Frontend Processing (0-20ms) ==
User -> React : Drop image (5ms)
React -> React : Validate size (10ms)
React -> React : Read base64 (15ms)
React -> API : POST to backend (20ms)

== Backend & External (20-90ms) ==
API -> BE : HTTP request (25ms)
BE -> Imgur : Upload image (35ms)
Imgur -> Imgur : Process & store (40-60ms)
Imgur --> BE : Image URL (80ms)
BE --> API : Response (85ms)
API --> React : URL received (90ms)

== Display Result (90-100ms) ==
React --> User : Show preview (95ms)

@enduml

@startuml Sequence_Timing_CacheInvalidation
title Frontend Cache & State Updates - Sequence with Timing

participant "User" as User
participant "API" as API
participant "React State" as State
participant "Browser Cache" as Cache

== Initial Load (0-60ms) ==
User -> API : Click refresh (20ms)
API -> State : Fetch request (40ms)
API --> State : Response (55ms)
State -> Cache : Cache data (60ms)

== Edit Operation (60-150ms) ==
User -> State : Edit university (120ms)
State -> API : PUT update (130ms)
API --> State : Updated data (150ms)

== Cache Refresh (150-250ms) ==
State -> Cache : Invalidate & refresh (150ms)
State -> State : Mark stale (200ms)
Cache -> State : Fresh data (250ms)

@enduml
