@startuml Component_SystemOverview
skinparam componentStyle rectangle
skinparam linetype ortho

title Du Học Cost - Component Diagram

package "Client Browser" {
    [Web Browser] as Browser
}

package "Frontend Application (Vercel)" {
    package "React Core" {
        [React App] as ReactApp
        [React Router DOM] as Router
        [Vite Build Tool] as Vite
    }
    
    package "Context Providers" {
        [AuthContext] as AuthCtx
        [AppContext] as AppCtx
    }
    
    package "UI Components" {
        [Layout Component] as Layout
        [UniversitiesList] as UnivList
        [AdminDashboard] as AdminDash
        [AdminInvite] as AdminInv
        [PermissionGuard] as PermGuard
        [Forms & Modals] as Forms
    }
    
    package "Services" {
        [API Client (Axios)] as ApiClient
        [University API] as UnivAPI
        [Auth API] as AuthAPI
        [Admin Invite API] as InviteAPI
    }
    
    package "State Management" {
        [Local Storage] as LocalStorage
        [useState Hooks] as StateHooks
    }
}

package "Backend API (Render)" {
    package "Express Server" {
        [Express App] as Express
        [CORS Middleware] as CORS
        [Body Parser] as BodyParser
    }
    
    package "Security Layer" {
        [Authentication Middleware] as AuthMiddleware
        [RBAC Middleware] as RBACMiddleware
        [JWT Handler] as JWTHandler
    }
    
    package "Route Handlers" {
        [Auth Routes] as AuthRoutes
        [University Routes] as UnivRoutes
        [Registration Routes] as RegRoutes
        [Admin Invite Routes] as InviteRoutes
    }
    
    package "Database Access" {
        [pg Pool] as PgPool
        [Query Builder] as QueryBuilder
    }
}

package "Database (Supabase)" {
    [PostgreSQL Database] as Postgres
    
    package "Tables" {
        [Users Table] as UsersTbl
        [Universities Table] as UnivTbl
        [Registrations Table] as RegTbl
        [Student Progress Table] as ProgressTbl
        [Invitations Table] as InviteTbl
    }
}

package "External Services" {
    [Imgur API] as Imgur
    [JWT Service] as JWT
    [Email Service (SMTP)] as Email
}

' Connections
Browser --> ReactApp : HTTPS
ReactApp --> Vite
ReactApp --> Router
ReactApp --> AuthCtx
ReactApp --> AppCtx

AuthCtx --> LocalStorage : store/retrieve token
AuthCtx --> ApiClient : authenticated requests
AppCtx --> UnivAPI : manage universities
AppCtx --> AuthAPI : auth operations

Layout --> PermGuard : wrap content
UnivList --> Forms : open modals
AdminInv --> InviteAPI : send invites

ApiClient --> Express : REST API calls

Express --> CORS
Express --> BodyParser
Express --> AuthMiddleware
Express --> RBACMiddleware

AuthMiddleware --> JWTHandler : verify tokens
RBACMiddleware --> JWTHandler : check permissions

AuthMiddleware --> AuthRoutes : protected
RBACMiddleware --> UnivRoutes : protected
RBACMiddleware --> RegRoutes : protected
RBACMiddleware --> InviteRoutes : protected

AuthRoutes --> PgPool : queries
UnivRoutes --> PgPool : queries
RegRoutes --> PgPool : queries
InviteRoutes --> PgPool : queries

PgPool --> QueryBuilder
QueryBuilder --> Postgres : SQL

Postgres --> UsersTbl
Postgres --> UnivTbl
Postgres --> RegTbl
Postgres --> ProgressTbl
Postgres --> InviteTbl

UnivRoutes --> Imgur : upload images
InviteRoutes --> Email : send invites
JWTHandler --> JWT : sign/verify

@enduml

