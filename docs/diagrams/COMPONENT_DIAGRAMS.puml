@startuml Component_BackendArchitecture
skinparam componentStyle rectangle

title Backend API Component Architecture

package "Server Core" {
    [server.js] as Server
    [Express App] as Express
    [Configuration] as Config
}

package "Middleware Pipeline" {
    [CORS Handler] as CORS
    [Multi-Origin Config] as MultiOrigin
    [JSON Parser] as JSONParser
    [Static Files] as Static
    [Error Handler] as ErrorHandler
}

package "Security Components" {
    [Auth Middleware] as AuthMiddleware
    [RBAC Middleware] as RBACMiddleware
    [Password Hashing] as PasswordHash
    [JWT Service] as JWTService
}

package "Route Controllers" {
    [AuthController] as AuthCtrl
    [UniversityController] as UnivCtrl
    [RegistrationController] as RegCtrl
    [StudentController] as StudentCtrl
    [AdminInviteController] as InviteCtrl
    [ProgressController] as ProgressCtrl
}

package "Data Access Layer" {
    [Database Pool] as DBPool
    [Connection Manager] as ConnMgr
    [Query Executor] as QueryExec
    [Transaction Manager] as TransMgr
}

package "External Integrations" {
    [Email Service] as EmailSvc
    [Image Upload (Imgur)] as ImgurSvc
    [JWT Library] as JWTLib
    [bcrypt Library] as bcrypt
}

package "Models/Entities" {
    [User Model] as UserModel
    [University Model] as UnivModel
    [Registration Model] as RegModel
    [Invitation Model] as InviteModel
    [Progress Model] as ProgressModel
}

' Data flow
Server --> Express
Server --> Config

Express --> CORS : 1st
CORS --> MultiOrigin
MultiOrigin --> JSONParser : 2nd
Express --> JSONParser : 2nd
Express --> Static : 3rd
Express --> AuthMiddleware : 4th

AuthMiddleware --> JWTService : verify
AuthMiddleware --> RBACMiddleware : next

RBACMiddleware --> AuthCtrl : /api/auth
RBACMiddleware --> UnivCtrl : /api/universities
RBACMiddleware --> RegCtrl : /api/registrations
RBACMiddleware --> StudentCtrl : /api/students
RBACMiddleware --> InviteCtrl : /api/admin
RBACMiddleware --> ProgressCtrl : /api/progress

AuthCtrl --> UserModel
UnivCtrl --> UnivModel
RegCtrl --> RegModel
StudentCtrl --> UserModel
InviteCtrl --> UserModel
InviteCtrl --> InviteModel
ProgressCtrl --> ProgressModel

UserModel --> DBPool
UnivModel --> DBPool
RegModel --> DBPool
InviteModel --> DBPool
ProgressModel --> DBPool

DBPool --> ConnMgr
DBPool --> QueryExec
QueryExec --> TransMgr : transactions

InviteCtrl --> EmailSvc : send invites
UnivCtrl --> ImgurSvc : upload images
AuthCtrl --> JWTService : generate tokens
AuthCtrl --> PasswordHash : hash/verify

JWTService --> JWTLib
PasswordHash --> bcrypt

Express --> ErrorHandler : final

@enduml
