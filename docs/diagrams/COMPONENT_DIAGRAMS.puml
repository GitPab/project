Layout --> Header
Layout --> Footer

Sidebar --> AdminDash
Sidebar --> AdminRoles
Sidebar --> UnivList
Sidebar --> StudentMgmt
Sidebar --> RegMgmt

AdminDash --> PermGuard
AdminRoles --> PermGuard
UnivList --> PermGuard

UnivList --> UnivForm
UnivList --> EditModal
UnivList --> ImportModal
UnivList --> QuickInfo
AdminRoles --> AdminInv

UnivForm --> Button
UnivForm --> Input
UnivForm --> Modal
EditModal --> Button
EditModal --> Input
ImportModal --> Button
ImportModal --> Table
AdminInv --> Button
AdminInv --> Input

PermGuard --> UsePerm
