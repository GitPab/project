    usecase "Submit Application" as UC3
    usecase "Validate Application" as UC4
    usecase "Send Confirmation Email" as UC5
    usecase "Review Application" as UC6
    usecase "Request Additional Info" as UC7
    usecase "Approve Application" as UC8
