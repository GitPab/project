@startuml Class_FrontendComponents
title Frontend Components - Class Diagram

package "React Components" {
    
    class Component <<React.Component>> {
        +props
        +state
        +render()
        +componentDidMount()
        +componentDidUpdate()
    }
    
    class Layout {
        +boolean sidebarCollapsed
        +Array menuItems
        +User currentUser
        +toggleSidebar()
        +handleLogout()
        +renderSidebar()
        +renderHeader()
    }
    
    class UniversitiesList {
        -Array universities
        -string searchQuery
        -boolean loading
        -boolean showAddModal
        -boolean showEditModal
        -University selectedUniversity
        +fetchUniversities()
        +handleSearch(query)
        +handleAdd(universityData)
        +handleEdit(id, data)
        +handleDelete(id)
        +handleQuickInfo(id)
        +openAddModal()
        +closeAddModal()
    }
    
    class UniversityForm {
        -object formData
        -boolean loading
        -Array uploadedImages
        +handleInputChange(field, value)
        +handleImageUpload(file)
        +handleSubmit()
        +validateForm()
        +resetForm()
    }
    
    class EditUniversityModal {
        -University university
        -object formData
        -boolean saving
        +handleInputChange(field, value)
        +handleSave()
        +handleClose()
    }
    
    class AdminInvite {
        -Array invitedUsers
        -boolean showInviteForm
        -string copiedLink
        -object formData
        +fetchInvitedUsers()
        +inviteUser(data)
        +resendInvite(invitationId)
        +copyInviteLink(url)
        +toggleInviteForm()
    }
    
    class AdminDashboard {
        -object stats
        -Array recentActivity
        -Array pendingApprovals
        +fetchDashboardData()
        +handleImportCSV()
        +refreshStats()
    }
    
    class AdminRoles {
        -Array users
        -Array roles
        -boolean loading
        -string activeTab
        +fetchUsers()
        +fetchRoles()
        +updateUserRole(userId, role)
        +deleteUser(userId)
        +switchTab(tab)
    }
    
    class PermissionGuard {
        +string permission
        +ReactNode children
        +ReactNode fallback
        -boolean hasPermission
        +checkPermission()
        +render()
    }
    
    class QuickInfoModal {
        -University university
        -boolean loading
        +fetchUniversityDetails(id)
        +handleClose()
    }
    
    class ImportUniversitiesModal {
        -File csvFile
        -Array previewData
        -boolean importing
        -int validRows
        -int invalidRows
        +handleFileSelect(file)
        +parseCSV()
        +validateData()
        +handleImport()
        +handleCancel()
    }
}

package "React Context" {
    
    class AuthProvider {
        +User user
        +boolean isAuthenticated
        +boolean isAdmin
        +boolean loading
        +login(email, password)
        +logout()
        +hasPermission(permission)
        +checkAuthStatus()
    }
    
    class AppProvider {
        +Array universities
        +Array students
        +Array registrations
        +boolean loading
        +addUniversity(data)
        +updateUniversity(id, data)
        +deleteUniversity(id)
        +addUniversities(data)
        +fetchUniversities()
        +fetchStudents()
        +fetchRegistrations()
    }
}

package "Services" {
    
    class universityApi {
        +{static} getAll()
        +{static} getById(id)
        +{static} create(data)
        +{static} update(id, data)
        +{static} delete(id)
        +{static} importCSV(data)
    }
    
    class authApi {
        +{static} login(email, password)
        +{static} logout()
        +{static} getCurrentUser()
        +{static} refreshToken()
    }
    
    class adminInviteApi {
        +{static} invite(data)
        +{static} getInvitedUsers()
        +{static} verifyToken(token)
        +{static} setupPassword(token, password)
        +{static} resendInvite(id)
    }
}

package "Types" {
    
    class University {
        +UUID id
        +string name
        +string koreanName
        +string region
        +string heroImage
        +string thumbnail
        +object koreanData
        +Date createdAt
        +Date updatedAt
    }
    
    class User {
        +UUID id
        +string email
        +string name
        +Role role
        +string phone
        +Date createdAt
    }
    
    class Registration {
        +UUID id
        +UUID studentId
        +UUID universityId
        +string status
        +object formData
        +Date createdAt
    }
    
    enum Role {
        SUPER_ADMIN
        ADMIN
        ADMIN_MANAGER
        CONTENT_EDITOR
        FINANCE_ADMIN
        VIEWER
        STUDENT
    }
}

Component <|-- Layout
Component <|-- UniversitiesList
Component <|-- UniversityForm
Component <|-- EditUniversityModal
Component <|-- AdminInvite
Component <|-- AdminDashboard
Component <|-- AdminRoles
Component <|-- PermissionGuard
Component <|-- QuickInfoModal
Component <|-- ImportUniversitiesModal

UniversitiesList --> UniversityForm : uses
UniversitiesList --> EditUniversityModal : uses
UniversitiesList --> QuickInfoModal : uses
UniversitiesList --> ImportUniversitiesModal : uses
UniversitiesList --> universityApi : uses

AdminRoles --> AdminInvite : contains
AdminRoles --> authApi : uses

PermissionGuard --> AuthProvider : uses

AuthProvider --> authApi : uses
AppProvider --> universityApi : uses

UniversityForm --> universityApi : uses
AdminInvite --> adminInviteApi : uses

@enduml

@startuml Class_BackendAPI
title Backend API - Class Diagram

package "Express Server" {
    
    class Server {
        +Express app
        +int port
        +start()
        +setupMiddleware()
        +setupRoutes()
        +setupErrorHandling()
    }
    
    class DatabaseConnection {
        -Pool pool
        +connect()
        +disconnect()
        +query(sql, params)
        +transaction(callback)
    }
}

package "Middleware" {
    
    class AuthenticationMiddleware {
        +verifyToken(req, res, next)
        -decodeToken(token)
        -validateExpiration(decoded)
    }
    
    class RBACMiddleware {
        +checkPermission(action, resource)
        +requirePermission(action, resource)
        -hasPermission(role, action, resource)
        -getRolePermissions(role)
    }
    
    class CORSMiddleware {
        +configureCors()
        -allowedOrigins
    }
    
    class ErrorHandler {
        +handleError(err, req, res, next)
        +logError(err)
    }
}

package "Route Controllers" {
    
    class AuthController {
        +login(req, res)
        +logout(req, res)
        +getCurrentUser(req, res)
        +refreshToken(req, res)
        -generateToken(user)
        -validatePassword(password, hash)
    }
    
    class UniversityController {
        +getAll(req, res)
        +getById(req, res)
        +create(req, res)
        +update(req, res)
        +delete(req, res)
        +importCSV(req, res)
        -validateUniversityData(data)
        -checkDuplicates(name)
    }
    
    class RegistrationController {
        +getAll(req, res)
        +getById(req, res)
        +create(req, res)
        +update(req, res)
        +delete(req, res)
        +approve(req, res)
        +reject(req, res)
        -notifyStudent(studentId, status)
    }
    
    class StudentController {
        +getAll(req, res)
        +getById(req, res)
        +create(req, res)
        +update(req, res)
        +delete(req, res)
        +getProgress(req, res)
        +updateProgress(req, res)
    }
    
    class AdminInviteController {
        +inviteUser(req, res)
        +getInvitedUsers(req, res)
        +verifySetupToken(req, res)
        +setupPassword(req, res)
        +resendInvite(req, res)
        -generateSetupToken()
        -calculateExpiry()
        -sendInviteEmail(email, token)
    }
    
    class PaymentController {
        +getAll(req, res)
        +getById(req, res)
        +create(req, res)
        +update(req, res)
        +delete(req, res)
        +getStudentSummary(req, res)
    }
    
    class NotificationController {
        +getAll(req, res)
        +getUnreadCount(req, res)
        +create(req, res)
        +broadcast(req, res)
        +markAsRead(req, res)
        +markAllAsRead(req, res)
        +clearAll(req, res)
    }
    
    class DocumentController {
        +getAll(req, res)
        +getById(req, res)
        +upload(req, res)
        +review(req, res)
        +delete(req, res)
    }
    
    class MessageController {
        +getInbox(req, res)
        +getSent(req, res)
        +getById(req, res)
        +send(req, res)
        +delete(req, res)
    }
    
    class AppointmentController {
        +getAll(req, res)
        +getById(req, res)
        +create(req, res)
        +update(req, res)
        +cancel(req, res)
        +delete(req, res)
        +getAvailableSlots(req, res)
    }
    
    class ScholarshipController {
        +getAll(req, res)
        +getById(req, res)
        +create(req, res)
        +update(req, res)
        +delete(req, res)
        +apply(req, res)
        +getMyApplications(req, res)
        +reviewApplication(req, res)
    }
    
    class VisaController {
        +getAll(req, res)
        +getById(req, res)
        +create(req, res)
        +update(req, res)
        +delete(req, res)
        +updateStatus(req, res)
    }
    
    class PreferenceController {
        +get(req, res)
        +create(req, res)
        +update(req, res)
        +updateSingle(req, res)
    }
}

package "Models (v2.0 - 15 Entities)" {
    
    class UserModel {
        +UUID id
        +string email
        +string name
        +string passwordHash
        +string role
        +string setupToken
        +Date setupTokenExpiry
        +create(data)
        +findByEmail(email)
        +findById(id)
        +update(id, data)
        +delete(id)
    }
    
    class UniversityModel {
        +UUID id
        +string name
        +string koreanName
        +string region
        +string heroImage
        +string thumbnail
        +object koreanData
        +create(data)
        +findAll()
        +findById(id)
        +update(id, data)
        +delete(id)
    }
    
    class RegistrationModel {
        +UUID id
        +UUID studentId
        +UUID universityId
        +string status
        +object formData
        +create(data)
        +findAll(filters)
        +findById(id)
        +update(id, data)
    }
    
    class InvitationModel {
        +UUID id
        +string email
        +string name
        +string role
        +UUID invitedBy
        +string setupToken
        +Date setupTokenExpiry
        +boolean used
        +create(data)
        +findByToken(token)
        +markAsUsed(id)
    }
    
    class PaymentModel {
        +UUID id
        +UUID studentId
        +UUID registrationId
        +decimal amount
        +string currency
        +string method
        +string status
        +Date paidAt
        +create(data)
        +findByStudent(studentId)
        +updateStatus(id, status)
    }
    
    class NotificationModel {
        +UUID id
        +UUID userId
        +string type
        +string title
        +string message
        +boolean isRead
        +Date readAt
        +create(data)
        +findByUser(userId)
        +markAsRead(id)
        +markAllAsRead(userId)
    }
    
    class DocumentModel {
        +UUID id
        +UUID studentId
        +string type
        +string url
        +string status
        +UUID reviewedBy
        +Date reviewedAt
        +create(data)
        +findByStudent(studentId)
        +updateStatus(id, status, reviewer)
    }
    
    class MessageModel {
        +UUID id
        +UUID senderId
        +UUID receiverId
        +string subject
        +string content
        +boolean isRead
        +boolean isDeleted
        +create(data)
        +findInbox(userId)
        +findSent(userId)
        +markAsRead(id)
        +softDelete(id)
    }
    
    class AppointmentModel {
        +UUID id
        +UUID studentId
        +UUID staffId
        +string title
        +string description
        +Date scheduledAt
        +string status
        +create(data)
        +findByStudent(studentId)
        +findByStaff(staffId)
        +updateStatus(id, status)
    }
    
    class ScholarshipModel {
        +UUID id
        +string name
        +string description
        +decimal amount
        +Date deadline
        +object requirements
        +create(data)
        +findAll()
        +findById(id)
    }
    
    class ScholarshipApplicationModel {
        +UUID id
        +UUID scholarshipId
        +UUID studentId
        +string status
        +Date appliedAt
        +object applicationData
        +create(data)
        +findByStudent(studentId)
        +findByScholarship(id)
        +updateStatus(id, status)
    }
    
    class VisaApplicationModel {
        +UUID id
        +UUID studentId
        +string visaType
        +string status
        +Date submittedAt
        +Date approvedAt
        +object applicationData
        +create(data)
        +findByStudent(studentId)
        +updateStatus(id, status)
    }
    
    class UserPreferenceModel {
        +UUID id
        +UUID userId
        +string language
        +string theme
        +string currency
        +boolean notificationsEnabled
        +object preferences
        +create(data)
        +findByUser(userId)
        +update(userId, data)
    }
}

package "Utilities" {
    
    class JWTService {
        +sign(payload, secret, options)
        +verify(token, secret)
        +decode(token)
    }
    
    class PasswordService {
        +hash(password)
        +compare(password, hash)
    }
    
    class EmailService {
        +sendInvite(email, setupUrl)
        +sendNotification(email, subject, body)
        +sendWelcome(email, name)
    }
}

